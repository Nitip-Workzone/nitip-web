# =========================================
# Nitip Web — Example ENV
# =========================================

# Server Port (Nitro SSR)
PORT=3000

# API URL
# Prod:
NUXT_PUBLIC_NITIP_API_URL=https://api.nihtip.com
# Dev:
# NUXT_PUBLIC_NITIP_API_URL=http://localhost:8000
# API_BASE_URL=http://localhost:8000/api/v1

# API Client Credentials
# Get these from nitip-core:
#   make register-client APP=nitip-web PLAT=web
NUXT_PUBLIC_NITIP_API_KEY=your_api_key_here

# NOTE: Web & mobile API keys are intentionally DIFFERENT per platform.
# 500 in WebView build-apk-wa is NOT caused by different keys, but by:
# - key not registered in prod DB (need register-client on prod)
# - NUXT_PUBLIC_NITIP_API_URL not set during build (grant -> /api/v1 404 -> 500 error.vue)
# - PWA Service Worker caching old 500 page (now fixed with clearCache + PWA disabled)

# =========================================
# Asset CDN — Single Source of Truth https://upload.nihtip.com/
# =========================================
# Default https://upload.nihtip.com/ — bisa diubah ke https://assets.nihtip.com tanpa refactor
NUXT_PUBLIC_UPLOAD_BASE_URL=https://upload.nihtip.com/
ASSET_BASE_URL=https://upload.nihtip.com/

# =========================================
# Firebase Web Push — FCM untuk Web (Replaces polling 15s/10s/5s/30s)
# =========================================
# How to get:
# 1. Firebase Console > Project Settings > General > Your apps > Web app > SDK setup > Config
# 2. Cloud Messaging > Web Push certificates > Generate key pair (VAPID)
# Docs: https://firebase.google.com/docs/cloud-messaging/js/client
#
# Without these envs, build still passes (useFcm.ts has dynamic import fallback), but web push token won't be obtained.
# BE dispatcher still works via firebase-credentials.json (service account), SW background notification-only still works.
# For full FCM web push (foreground onMessage + token saving PUT /users/fcm-token), fill all 7 below.

# Web API Key (from Config > apiKey)
NUXT_PUBLIC_FIREBASE_API_KEY=

# Auth Domain (e.g. nihtip-f5178.firebaseapp.com)
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Project ID (e.g. nihtip-f5178)
NUXT_PUBLIC_FIREBASE_PROJECT_ID=nihtip-f5178

# Storage Bucket (e.g. nihtip-f5178.firebasestorage.app)
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Messaging Sender ID (e.g. 123456789)
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# App ID (e.g. 1:123456789:web:abcdef)
NUXT_PUBLIC_FIREBASE_APP_ID=

# VAPID Key (Web Push certificate key pair, from Cloud Messaging > Web Push certificates)
# Required for getToken() to get web push token, then saved to backend via PUT /users/fcm-token
# Without VAPID, getToken() fails, fallback to SSE only (still realtime via pool_hub)
NUXT_PUBLIC_FIREBASE_VAPID_KEY=

# =========================================
# FCM + SSE Realtime Notes
# =========================================
# - Polling intervals removed: notifications 15s, orders active 10s, QRIS 5s, merchant fallback 30s, CS queue 10s
# - Now: SSE PoolHub (GET /pool/stream + /orders/{id}/stream) primary + FCM backup + hidden tab SW
# - Dispatcher per-device bucket 20/10m + collapse_id order_{id} wallet_{user} prevents limit 600k/min
# - SW file: public/firebase-messaging-sw.js (lightweight, no page cache, only notificationclick handling)
# - Permission flow: notifications.client.ts after 3s + click gesture -> Notification.requestPermission()
#   -> useFcm.ts getToken() -> save token PUT /users/fcm-token -> BE can push even when tab closed
# - If user denies permission: show banner how to enable manual in browser settings (e.g. chrome://settings/content/notifications)
